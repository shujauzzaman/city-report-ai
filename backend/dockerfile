FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Copy project file
COPY ["SmartCity.API/SmartCity.API.csproj", "SmartCity.API/"]

# Restore dependencies
RUN dotnet restore "SmartCity.API/SmartCity.API.csproj"

# Copy the entire backend
COPY . .

WORKDIR /src/SmartCity.API

# Publish
RUN dotnet publish "SmartCity.API.csproj" \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false \
    /p:SixLaborsLicenseFile="/src/SmartCity.API/sixlabors.lic"

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "SmartCity.API.dll"]